# Copy to .env and fill in ONLY the values for the provider you use.
# PLACEHOLDERS ONLY — never commit a real key. .env is git-ignored.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.1
RETRIEVAL_TOP_K=4
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=20
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
HUGGINGFACEHUB_API_TOKEN=your-hugging-face-token-here
GEMINI_API_KEY=your-free-google-ai-studio-key-here
